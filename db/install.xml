<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/documents/db" VERSION="20261027" COMMENT="Official school documents: series, types, template versions, issued documents, numbering and their log"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_documents_series" COMMENT="Document series of the Tabla de Retencion Documental (TRD): the first part of every number">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="code" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="Siglas, e.g. CONSES"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="trdcode" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="TRD code, e.g. 25.11"/>
        <FIELD NAME="parentcode" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="Siglas of the series this sub-series belongs to"/>
        <FIELD NAME="docvalue" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="Valor documental: legal, administrativo"/>
        <FIELD NAME="keepactive" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="5" SEQUENCE="false" COMMENT="Years in the archivo de tramite"/>
        <FIELD NAME="keepcentral" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="10" SEQUENCE="false" COMMENT="Years in the archivo de concentracion"/>
        <FIELD NAME="permanent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Kept permanently (historic) after both periods"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code" UNIQUE="true" FIELDS="code"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_type" COMMENT="A document the school issues: a series, who it is about, where its data comes from and its current template version">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="seriesid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="subject" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="student" SEQUENCE="false" COMMENT="student, staff, person (typed in) or none (a letter)"/>
        <FIELD NAME="source" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="basic" SEQUENCE="false" COMMENT="basic or grades: what is read to prepopulate"/>
        <FIELD NAME="unitcode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="DCE" SEQUENCE="false" COMMENT="Issuing authority or unit (5th part of the number)"/>
        <FIELD NAME="validitydays" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = no expiry"/>
        <FIELD NAME="signaturemode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="electronic" SEQUENCE="false" COMMENT="electronic (signed on the platform) or handwritten (valid only with the original signature and seal)"/>
        <FIELD NAME="companions" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Shortnames of the types suggested to go with it as a file, comma-separated"/>
        <FIELD NAME="currentversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="local_documents_tplver id in use"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="seriesid" TYPE="foreign" FIELDS="seriesid" REFTABLE="local_documents_series" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="shortname" UNIQUE="true" FIELDS="shortname"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_tplver" COMMENT="One immutable version of a document type's template; every save adds a row with its change note">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="typeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="version" TYPE="int" LENGTH="5" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Printed title, e.g. CONSTANCIA DE ESTUDIO"/>
        <FIELD NAME="body" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Text with {{placeholders}}, blank-line paragraphs, **bold**"/>
        <FIELD NAME="fields" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON list of the fields the issuer fills in"/>
        <FIELD NAME="signatories" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="How many signature blocks"/>
        <FIELD NAME="allowbodyedit" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="changenote" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="typeid" TYPE="foreign" FIELDS="typeid" REFTABLE="local_documents_type" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="typeversion" UNIQUE="true" FIELDS="typeid, version"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_doc" COMMENT="One version of one document: a draft until issued, then frozen (number, text, PDF and its hash)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="typeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="tplverid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="seriesid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft, pending (waiting for signatures), issued, superseded, recalled"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The student or staff member it is about, 0 when typed in or none"/>
        <FIELD NAME="holdername" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="holderidnumber" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="number" TYPE="char" LENGTH="150" NOTNULL="false" SEQUENCE="false" COMMENT="Full number, set when issued"/>
        <FIELD NAME="seriescode" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="correlative" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="year" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="unitcode" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sacecode" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="jornada" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rootid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="First version of this document; equal to id for version 1"/>
        <FIELD NAME="docversion" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="verifycode" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="bodytext" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Body after placeholders, as edited by the issuer"/>
        <FIELD NAME="data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON snapshot: field values, school, signatories, tables"/>
        <FIELD NAME="issuedate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The date printed on the document"/>
        <FIELD NAME="validuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="SHA-256 of the issued PDF"/>
        <FIELD NAME="issuedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeissued" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="supersededby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="recalledby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timerecalled" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="recallreason" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Internal"/>
        <FIELD NAME="recallnote" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Shown on the verification page"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="typeid" TYPE="foreign" FIELDS="typeid" REFTABLE="local_documents_type" REFFIELDS="id"/>
        <KEY NAME="tplverid" TYPE="foreign" FIELDS="tplverid" REFTABLE="local_documents_tplver" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="verifycode" UNIQUE="true" FIELDS="verifycode"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="rootid" UNIQUE="false" FIELDS="rootid"/>
        <INDEX NAME="number" UNIQUE="false" FIELDS="number"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_counter" COMMENT="Last correlative used per series, year and issuing unit">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="seriesid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="year" TYPE="int" LENGTH="4" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="unitcode" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="lastvalue" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="seriesyearunit" UNIQUE="true" FIELDS="seriesid, year, unitcode"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_log" COMMENT="What happened to each document: created, edited, issued, downloaded, revised, recalled, verified">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="docid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="action" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="info" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="docid" TYPE="foreign" FIELDS="docid" REFTABLE="local_documents_doc" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="action" UNIQUE="false" FIELDS="action"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_unit" COMMENT="An issuing unit (5th part of the number): its head signs for it, its e-mail and phone go in the header">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="code" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Siglas, e.g. DCE"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="phone" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The Moodle user who signs for the unit"/>
        <FIELD NAME="signername" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Name as printed, e.g. Lic. Rosa Gomez; empty: the user's full name"/>
        <FIELD NAME="signertitle" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Position as printed, e.g. Directora"/>
        <FIELD NAME="substituteid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Who signs in substitution of the head, 0 for nobody"/>
        <FIELD NAME="substitutefrom" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="First day of the substitution, 0 from now"/>
        <FIELD NAME="substituteuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last day of the substitution, 0 until it is ended"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code" UNIQUE="true" FIELDS="code"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_unittype" COMMENT="The document types a unit may issue">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="unitid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="typeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="unitid" TYPE="foreign" FIELDS="unitid" REFTABLE="local_documents_unit" REFFIELDS="id"/>
        <KEY NAME="typeid" TYPE="foreign" FIELDS="typeid" REFTABLE="local_documents_type" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="unittype" UNIQUE="true" FIELDS="unitid, typeid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_signer" COMMENT="The signatures a document type requires, in order: none, one or several units; unitid 0 is the issuing unit">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="typeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="unitid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="typeid" TYPE="foreign" FIELDS="typeid" REFTABLE="local_documents_type" REFFIELDS="id"/>
        <KEY NAME="unitid" TYPE="foreign" FIELDS="unitid" REFTABLE="local_documents_unit" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="typeunit" UNIQUE="true" FIELDS="typeid, unitid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_documents_approval" COMMENT="One signature asked of one unit's head for one document version">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="docid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="unitid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Who must sign"/>
        <FIELD NAME="onbehalfof" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The head the signer substitutes, 0 when the head signs"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, approved"/>
        <FIELD NAME="timerequested" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timedecided" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ipaddress" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false" COMMENT="Where the signature was given from: evidence of the electronic signature"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="SHA-256 of the content signed (documents::fingerprint); issuing checks it still matches"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="docid" TYPE="foreign" FIELDS="docid" REFTABLE="local_documents_doc" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userstatus" UNIQUE="false" FIELDS="userid, status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
